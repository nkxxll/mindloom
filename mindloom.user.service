[Unit]
Description=Mindloom Server
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/mindloom
EnvironmentFile=%h/mindloom/.env
ExecStart=%h/.local/bin/uv run --project packages/server python packages/server/main.py
Restart=on-failure
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mindloom

[Install]
WantedBy=default.target
